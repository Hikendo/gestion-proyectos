{
  "compilerOptions": {
    "target": "ESNext",

    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,

    "jsx": "preserve",

    "resolveJsonModule": true,
    "esModuleInterop": true,

    "lib": ["ESNext", "DOM"],

    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["vite/client"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts"
  ]
}
