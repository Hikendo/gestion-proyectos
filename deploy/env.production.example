# ══════════════════════════════════════════════════════════════
# Plantilla de .env para el BACKEND (Laravel) en PRODUCCIÓN
# ─────────────────────────────────────────────────────────────
# Uso:
#   1) Copia este archivo al servidor como:
#        /opt/gestion-proyectos/backend/.env
#   2) Sustituye los tokens __...__ por tus valores reales.
#
# Notas:
#   • APP_ENV / APP_DEBUG / DB_* / SESSION_DOMAIN los fija el
#     docker-compose.prod.yml en runtime (no hace falta editarlos
#     aquí, pero se dejan coherentes por si ejecutas artisan sin Docker).
#   • Si creas un archivo deploy/.env.production (ver .gitignore),
#     el script 02-deploy-backend.sh lo usará automáticamente en el
#     primer despliegue. También sirve: una copia del .env local
#     ajustado (mantiene FIREBASE/REVERB que ya tengas funcionando).
# ══════════════════════════════════════════════════════════════

APP_NAME="Gestión de Proyectos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__DOMAIN__
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Base de datos (las fija docker-compose.prod.yml; aquí por compatibilidad) ──
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gestion_db
DB_USERNAME=gestion_user
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.__DOMAIN__

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@__DOMAIN__"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# 📧 RESEND EMAIL  https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=__RESEND_API_KEY__
RESEND_FROM_EMAIL="noreply@__DOMAIN__"

# ─────────────────────────────────────────────────────────────
# 🔔 GOOGLE FIREBASE CLOUD MESSAGING (HTTP v1)
# Consola Firebase → Configuración → Cuentas de servicio →
# Generar nueva clave privada. Copia los valores del JSON.
# ⚠️ FIREBASE_PRIVATE_KEY: todo en UNA línea, con saltos como \n
# ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=__FIREBASE_PROJECT_ID__
FIREBASE_PRIVATE_KEY_ID=__FIREBASE_PRIVATE_KEY_ID__
FIREBASE_PRIVATE_KEY="__FIREBASE_PRIVATE_KEY__"
FIREBASE_CLIENT_EMAIL=__FIREBASE_CLIENT_EMAIL__
FIREBASE_CLIENT_ID=__FIREBASE_CLIENT_ID__

# ─────────────────────────────────────────────────────────────
# 🔌 LARAVEL REVERB (WebSocket)
# REVERB_HOST/REVERB_PORT son la ruta INTERNA (servicio docker).
# El cliente web se conecta por nginx: wss://__DOMAIN__/app
# ─────────────────────────────────────────────────────────────
REVERB_APP_ID=350925
REVERB_APP_KEY=gestion_proyectos_reverb_key
REVERB_APP_SECRET=__REVERB_APP_SECRET__
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

SANCTUM_STATEFUL_DOMAINS=__DOMAIN__

VITE_APP_NAME="${APP_NAME}"
